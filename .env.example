# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production            # production | development | testing
APP_DEBUG=false               # never true in production
APP_URL=https://www.example.com
# 32+ random bytes, base64. Generate with:  php bin/console key:generate
APP_KEY=
APP_TIMEZONE=Asia/Kolkata

# The sign-in screen lives here, not on /login. Change it to anything you like.
LOGIN_PATH=/auth-control-panel/admin

# Redirect the bare domain <-> www to the host in APP_URL. Set false if a proxy does it.
CANONICAL_HOST_REDIRECT=true

# Comma-separated proxy IPs whose X-Forwarded-For is trusted (e.g. Cloudflare / load balancer).
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Database (MySQL 8+ / MariaDB 10.6+)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dropbox
DB_USERNAME=dropbox
DB_PASSWORD=
DB_SOCKET=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Absolute path, or relative to the project root. Keep it OUTSIDE the web root.
UPLOAD_DIR=storage/uploads
MEDIA_PUBLIC_PATH=/media
MAX_UPLOAD_SIZE_MB=10

# Where media files live: local | s3 | r2
STORAGE_DRIVER=local
# For s3 / r2 only. R2 endpoint: https://<account-id>.r2.cloudflarestorage.com, region "auto".
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL for files, e.g. https://media.example.com (R2 custom domain / CloudFront)
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=

# ---------------------------------------------------------------------------
# Email bootstrap (Admin -> Settings -> Email overrides these)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls           # tls | ssl | none
MAIL_FROM=
MAIL_FROM_NAME="Dropbox Reseller"

# ---------------------------------------------------------------------------
# Backups / cron
# ---------------------------------------------------------------------------
BACKUP_DIR=storage/backups
# Secret for the HTTP cron endpoint (/cron/run?token=...). Generate: php bin/console key:generate --raw
CRON_SECRET=

# ---------------------------------------------------------------------------
# Seeding the first administrator (php bin/console db:seed). Unset afterwards.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_CONTENT=true
